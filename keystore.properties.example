# Local signing for development. Copy this file to keystore.properties at the repository root
# (both names are gitignored) and fill in your own keystore. Without this file the build uses the
# machine's Android debug key, which differs per computer and cannot update an install made elsewhere.
#
# storeFile accepts an absolute path or a path relative to the repository root.
#   keytool -genkeypair -v -keystore framerevive-dev.jks -alias framerevive -keyalg RSA -keysize 2048 -validity 10000
storeFile=/absolute/path/to/framerevive-dev.jks
storePassword=changeit
keyAlias=framerevive
keyPassword=changeit
